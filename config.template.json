{
  "version": 3,
  "agents": {
    "defaults": {
      "model_name": "minimaxai/minimax-m3",
      "context_window": 1000000                        
    }
    
  },
  "model_list": [
    {
      "model_name": "minimaxai/minimax-m3",
      "model": "openai/minimaxai/minimax-m3",
      "api_base": "https://integrate.api.nvidia.com/v1",
      "api_keys": ["${NVIDIA_API_KEY}"]
    }
  ],
  "channel_list": {
    "telegram": {
      "enabled": true,
      "type": "telegram",
      "allow_from": ["${TELEGRAM_USER_ID}"]
    }
  },
  "tools": {
    "mcp": {
      "enabled": true,
      "servers": {
        "browser": {
          "enabled": true,
          "type": "http",
          "url": "https://backend-browser-agent.onrender.com/mcp"
        }
      }
    }
  }
}
