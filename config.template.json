{
  "version": 3,
  "agents": {
    "defaults": {
      "model_name": "z-ai/glm-5.2:free",
      "context_window": 262000                           
    }
    
  },
  "model_list": [
    {
      "model_name": "z-ai/glm-5.2:free",
      "model": "openai/z-ai/glm-5.2:free",
      "api_base": "https://openrouter.ai/api/v1/",
      "api_keys": ["${OPENROUTER_API_KEY}"]
    }
  ],
  "channel_list": {
    "telegram": {
      "enabled": true,
      "type": "telegram",
      "allow_from": ["${TELEGRAM_USER_ID}"]
    }
  },
  "tools": {
    "mcp": {
      "enabled": true,
      "servers": {
        "browser": {
          "enabled": true,
          "type": "http",
          "url": "https://backend-browser-agent.onrender.com/mcp"
        }
      }
    }
  }
}
